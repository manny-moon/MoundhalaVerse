---
import BaseLayout from '@layouts/BaseLayout.astro';
import SceneNav from '@components/SceneNav.astro';
import SettingsPanel from '@components/SettingsPanel.astro';
import Icon from '@components/Icon.astro';
import About from '@components/panels/About.astro';
import Experience from '@components/panels/Experience.astro';
import Projects from '@components/panels/Projects.astro';
import Skills from '@components/panels/Skills.astro';
import Contact from '@components/panels/Contact.astro';
import { profile, asset } from '@lib/site';

const description = `${profile.name} — ${profile.title}. ${profile.blurb}`;

// Split the name per character so each glyph can resolve on its own beat.
// Grouped by word so the heading still wraps normally on narrow viewports, and
// the running index keeps the stagger even across the space.
let charIndex = 0;
const nameWords = profile.name.split(' ').map((word) => {
  const chars = [...word].map((char) => ({ char, index: charIndex++ }));
  charIndex += 1; // account for the space so timing stays uniform
  return chars;
});
const nameLength = charIndex;
---

<BaseLayout title="The Moundhalaverse · Emmanuel Moundhala" description={description}>
  <!-- The WebGL stage. Decorative: every section it links to is also reachable
       from the nav rail and from /resume, so nothing here is load-bearing. -->
  <div id="stage" class="stage" data-mode="loading">
    <canvas id="scene" class="stage__canvas" aria-hidden="true"></canvas>
    <div class="stage__fallback" aria-hidden="true"></div>
    <p id="hover-label" class="stage__label" aria-hidden="true" hidden></p>
  </div>

  <main id="main" class="hud">
    <header class="intro">
      <p class="intro__eyebrow">
        <span class="intro__pulse" aria-hidden="true"></span>
        {profile.title} · Messiah University ’27
      </p>

      <h1 class="intro__name" aria-label={profile.name} style={`--n: ${nameLength}`}>
        {
          nameWords.map((word, w) => (
            <>
              {w > 0 && ' '}
              <span class="intro__word" aria-hidden="true">
                {word.map(({ char, index }) => (
                  <span class="intro__char" style={`--i: ${index}`}>{char}</span>
                ))}
              </span>
            </>
          ))
        }
      </h1>

      <p class="intro__headline">
        <span id="headline" class="headline" aria-live="off">Welcome to the Moundhalaverse</span>
      </p>

      <p class="visually-hidden">
        An interactive solar system. Each planet opens a section of this portfolio. Use the
        navigation below, or the arrow keys, to explore without the 3D view.
      </p>

      <p class="intro__blurb">{profile.blurb}</p>

      <div class="intro__actions">
        <button type="button" class="btn btn--solid" data-open="projects">
          <Icon name="code" size={16} /> See my work
        </button>
        <a class="btn" href={asset('/resume')}>
          <Icon name="external" size={16} /> Résumé
        </a>
        <a class="btn" href={profile.links.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={16} /> GitHub
        </a>
      </div>
    </header>
  </main>

  <SceneNav />
  <SettingsPanel />

  <div id="scrim" class="scrim" hidden></div>

  <About />
  <Experience />
  <Projects />
  <Skills />
  <Contact />
</BaseLayout>

<script>
  import { boot } from '@scripts/app';
  import { sections, phrases, profile, asset } from '@lib/site';

  boot({
    planets: sections,
    phrases,
    portraitUrl: asset(profile.sunTexture),
  });
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: var(--z-canvas);
    background: radial-gradient(ellipse at 50% 42%, #171a3d 0%, #08081a 55%, #04040e 100%);
  }

  .stage__canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .stage[data-mode='ready'] .stage__canvas {
    opacity: 1;
  }

  /* Shown when WebGL is unavailable or the scene chunk fails to load.
     Must not take pointer events: it covers the canvas at inset 0 and paints
     after it, so without this it silently swallows every hover and click meant
     for the planets. */
  .stage__fallback {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease);
    background:
      radial-gradient(1.5px 1.5px at 20% 30%, rgb(255 255 255 / 0.7), transparent),
      radial-gradient(1.5px 1.5px at 70% 20%, rgb(255 255 255 / 0.5), transparent),
      radial-gradient(2px 2px at 40% 70%, rgb(255 255 255 / 0.6), transparent),
      radial-gradient(1px 1px at 85% 60%, rgb(255 255 255 / 0.5), transparent),
      radial-gradient(1.5px 1.5px at 10% 80%, rgb(255 255 255 / 0.4), transparent),
      radial-gradient(circle at 50% 45%, rgb(255 176 32 / 0.28), transparent 40%);
  }

  .stage[data-mode='fallback'] .stage__fallback {
    opacity: 1;
  }

  /* Floating planet label, positioned from the render loop. */
  .stage__label {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.3rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    color: var(--ink);
    background: rgb(4 4 14 / 0.78);
    border: 1px solid var(--glass-line-strong);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    will-change: transform;
  }

  /* --- HUD ---------------------------------------------------------------- */

  /* Guarantees contrast for the copy no matter where the star drifts. The
     scene is bright and moves; the text can't be left to chance. */
  .hud::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      rgb(4 4 14 / 0.92) 0%,
      rgb(4 4 14 / 0.78) 26%,
      rgb(4 4 14 / 0.35) 48%,
      transparent 68%
    );
  }

  .hud {
    position: relative;
    z-index: var(--z-chrome);
    display: flex;
    align-items: center;
    min-height: 100svh;

    /* Contains the buttons' flight paths.
       A transformed box still contributes its bounding box to the page's
       scrollable overflow, and the flights start off-screen — below the fold
       for the launch curve. That grew the scroll area mid-animation, popped a
       vertical scrollbar, and the scrollbar appearing resized the viewport,
       which read as the page shaking.
       `clip` contains it without creating a scroll container of its own, and
       nothing is lost visually because the clip edge is the viewport edge. */
    overflow: clip;
    padding:
      max(var(--sp-6), env(safe-area-inset-top))
      max(var(--sp-6), env(safe-area-inset-right))
      calc(var(--sp-8) + 3rem)
      max(var(--sp-6), env(safe-area-inset-left));
    pointer-events: none;
  }

  /* Only interactive children take pointer events — the rest of the HUD lets
     clicks fall through to the canvas so the scene stays draggable. */
  .hud :global(a),
  .hud :global(button) {
    pointer-events: auto;
  }

  .intro {
    max-width: 34rem;
    display: grid;
    gap: var(--sp-4);
  }

  .intro__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  .intro__pulse {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--experience);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--experience) 70%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    70%  { box-shadow: 0 0 0 0.6rem transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* `background-clip: text` can't be used here. The characters have to be
     inline-block to accept a transform, which makes each one an atomic inline
     whose glyphs are no longer part of the <h1>'s own text run — so the
     clipped gradient never paints into them and the name renders invisible.
     Each character samples the ramp itself instead, which survives transforms
     and gives the same left-to-right warm-to-cool sweep. */
  .intro__name {
    font-size: var(--text-3xl);
    line-height: 1.02;
    color: #fff5e2;
  }

  .intro__word {
    display: inline-block;
  }

  .intro__char {
    display: inline-block;
    /* Position along the name, 0 to 1. */
    --t: calc(var(--i) / var(--n));
    color: color-mix(in oklab, #fff5e2, #9fc8ff calc(var(--t) * 88%));
    opacity: 0;
    /* Only opacity and transform animate, both compositor-friendly. */
    will-change: transform, opacity;
  }

  body[data-stage='ready'] .intro__char {
    animation: charIn 900ms var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 52ms);
  }

  @keyframes charIn {
    from {
      opacity: 0;
      transform: translateY(0.5em) rotate(9deg) scale(0.88);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .intro__headline {
    min-height: 1.9em;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }

  .headline::after {
    content: '';
    display: inline-block;
    width: 0.6ch;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--contact);
    animation: caret 1.05s step-end infinite;
  }

  .headline.is-static::after {
    animation: none;
    opacity: 0.5;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .intro__blurb {
    color: var(--ink-mute);
    font-size: var(--text-base);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }

  /* Transform and opacity only - no filter. Animating blur forces a full
     repaint every frame, which is what made this choppy alongside the scene. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Entrance choreography. Timings run against the camera's intro dolly so
     the copy and the scene resolve together. */
  .intro__eyebrow,
  .intro__headline,
  .intro__blurb,
  .intro__actions > * {
    opacity: 0;
  }

  /* Nothing starts until the scene has compiled its shaders and reported
     ready. Running this against a thread that is busy building WebGL pipelines
     is what made the entrance stutter. */
  body[data-stage='ready'] :is(
    .intro__eyebrow,
    .intro__headline,
    .intro__blurb
  ) {
    animation: rise 1000ms var(--ease-out) forwards;
  }

  body[data-stage='ready'] .intro__eyebrow  { animation-delay: 120ms; }
  body[data-stage='ready'] .intro__headline { animation-delay: 1450ms; }
  body[data-stage='ready'] .intro__blurb    { animation-delay: 1700ms; }

  /* --- The three calls to action fly in ----------------------------------- */

  .intro__actions > * {
    position: relative;
    opacity: 0;
    will-change: transform, opacity;
  }

  /*
     The buttons rest on the left of the hero, so they fly in from the right
     across the full width — a left-to-right approach would spend most of its
     travel off-screen.

     These are transform keyframes rather than `offset-path`. Motion path
     positions the element's anchor relative to its containing block, not its
     natural spot, so the buttons settled tens of pixels off their layout
     position — the first one ended up off the left edge entirely. Waypoints
     land at `transform: none`, which is the resting position by definition.
     Rotation is authored per keyframe to bank each button into its curve.
  */

  /* The exhaust trail, hanging off the trailing (right) edge. It inherits the
     parent's bank, so it stays pointed back down the flight path. */
  .intro__actions > *::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: 320px;
    height: 5px;
    margin: -2.5px 0 0 -10px;
    border-radius: var(--radius-full);
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(
      to right,
      var(--trail),
      color-mix(in srgb, var(--trail) 55%, transparent) 30%,
      color-mix(in srgb, var(--trail) 15%, transparent) 62%,
      transparent 94%
    );
    opacity: 0;
    pointer-events: none;
  }

  /* Impact ring, timed to the moment it settles. */
  .intro__actions > *::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: var(--radius-full);
    border: 2px solid var(--trail);
    opacity: 0;
    pointer-events: none;
  }

  body[data-stage='ready'] .intro__actions > * {
    /* linear on purpose — the keyframe spacing carries the easing. An eased
       timing function is applied between *every* keyframe pair, so with
       waypoints this dense it would slow and re-accelerate 16 times over. */
    animation: var(--fly-name) var(--fly-dur) linear var(--fly-delay) forwards;
  }

  body[data-stage='ready'] .intro__actions > *::before {
    animation: trail var(--fly-dur) var(--ease-out) var(--fly-delay) forwards;
  }

  body[data-stage='ready'] .intro__actions > *::after {
    animation: impact var(--fly-dur) linear var(--fly-delay) forwards;
  }

  @keyframes trail {
    0%    { opacity: 0;   transform: scaleX(0.05); }
    12%   { opacity: 1;   transform: scaleX(1); }
    45%   { opacity: 0.8; transform: scaleX(0.78); }
    68%   { opacity: 0.2; transform: scaleX(0.28); }
    100%  { opacity: 0;   transform: scaleX(0); }
  }

  @keyframes impact {
    0%, 88% { opacity: 0;   scale: 0.85; }
    94%     { opacity: 0.9; scale: 1; }
    100%    { opacity: 0;   scale: 1.5; }
  }

  /* 1 — enters high on the right and sweeps down across the hero. */
  .intro__actions > *:nth-child(1) {
    --trail: var(--sun);
    --fly-name: flySweep;
    --fly-dur: 1950ms;
    --fly-delay: 1700ms;
  }

  @keyframes flySweep {
    0%     { opacity: 0; transform: translate(980px, -330px) rotate(-8.8deg) scale(0.300); }
    3.57%  { opacity: 1; transform: translate(892px, -353px) rotate(-4.7deg) scale(0.356); }
    7.14%  { transform: translate(805px, -364px) rotate(-1.7deg) scale(0.410); }
    10.71% { transform: translate(723px, -365px) rotate(0.6deg) scale(0.461); }
    14.29% { transform: translate(644px, -361px) rotate(2.4deg) scale(0.509); }
    17.86% { transform: translate(570px, -352px) rotate(3.8deg) scale(0.555); }
    21.43% { transform: translate(501px, -340px) rotate(5.1deg) scale(0.598); }
    25%    { transform: translate(436px, -325px) rotate(6.2deg) scale(0.639); }
    28.57% { transform: translate(376px, -309px) rotate(7.3deg) scale(0.677); }
    32.14% { transform: translate(320px, -292px) rotate(8.2deg) scale(0.713); }
    35.71% { transform: translate(269px, -274px) rotate(9.2deg) scale(0.747); }
    39.29% { transform: translate(222px, -255px) rotate(10.2deg) scale(0.778); }
    42.86% { transform: translate(179px, -236px) rotate(11.3deg) scale(0.807); }
    46.43% { transform: translate(140px, -217px) rotate(12.0deg) scale(0.833); }
    50%    { transform: translate(105px, -197px) rotate(12.0deg) scale(0.858); }
    53.57% { transform: translate(74px, -178px) rotate(12.0deg) scale(0.880); }
    57.14% { transform: translate(56px, -151px) rotate(12.0deg) scale(0.900); }
    60.71% { transform: translate(43px, -125px) rotate(10.0deg) scale(0.918); }
    64.29% { transform: translate(32px, -102px) rotate(8.0deg) scale(0.934); }
    67.86% { transform: translate(23px, -80px) rotate(6.3deg) scale(0.949); }
    71.43% { transform: translate(16px, -62px) rotate(4.8deg) scale(0.961); }
    75%    { transform: translate(11px, -46px) rotate(3.5deg) scale(0.971); }
    78.57% { transform: translate(7px, -32px) rotate(2.5deg) scale(0.980); }
    82.14% { transform: translate(4px, -21px) rotate(1.6deg) scale(0.987); }
    85.71% { transform: translate(2px, -13px) rotate(1.0deg) scale(0.992); }
    89.29% { transform: translate(1px, -7px) rotate(0.5deg) scale(0.996); }
    92.86% { transform: translate(0px, -3px) rotate(0.2deg) scale(0.998); }
    96.43% { transform: translate(0px, -1px) rotate(0.0deg) scale(1.000); }
    100%   { opacity: 1; transform: none; }
  }

  /* 2 — a shooting star climbing in from the lower right. */
  .intro__actions > *:nth-child(2) {
    --trail: #bfe4ff;
    --fly-name: flyStar;
    --fly-dur: 1900ms;
    --fly-delay: 2050ms;
  }

  @keyframes flyStar {
    0%     { opacity: 0; transform: translate(940px, 330px) rotate(3.4deg) scale(0.300); }
    3.57%  { opacity: 1; transform: translate(857px, 338px) rotate(1.6deg) scale(0.356); }
    7.14%  { transform: translate(777px, 340px) rotate(-0.1deg) scale(0.410); }
    10.71% { transform: translate(702px, 338px) rotate(-1.7deg) scale(0.461); }
    14.29% { transform: translate(630px, 331px) rotate(-3.2deg) scale(0.509); }
    17.86% { transform: translate(563px, 321px) rotate(-4.6deg) scale(0.555); }
    21.43% { transform: translate(500px, 307px) rotate(-6.1deg) scale(0.598); }
    25%    { transform: translate(441px, 291px) rotate(-7.5deg) scale(0.639); }
    28.57% { transform: translate(387px, 273px) rotate(-9.0deg) scale(0.677); }
    32.14% { transform: translate(338px, 254px) rotate(-10.6deg) scale(0.713); }
    35.71% { transform: translate(293px, 232px) rotate(-12.0deg) scale(0.747); }
    39.29% { transform: translate(252px, 210px) rotate(-12.0deg) scale(0.778); }
    42.86% { transform: translate(216px, 186px) rotate(-12.0deg) scale(0.807); }
    46.43% { transform: translate(185px, 162px) rotate(-12.0deg) scale(0.833); }
    50%    { transform: translate(158px, 138px) rotate(-12.0deg) scale(0.858); }
    53.57% { transform: translate(136px, 112px) rotate(-12.0deg) scale(0.880); }
    57.14% { transform: translate(117px, 90px) rotate(-12.0deg) scale(0.900); }
    60.71% { transform: translate(98px, 70px) rotate(-10.0deg) scale(0.918); }
    64.29% { transform: translate(81px, 54px) rotate(-8.0deg) scale(0.934); }
    67.86% { transform: translate(65px, 40px) rotate(-6.3deg) scale(0.949); }
    71.43% { transform: translate(50px, 29px) rotate(-4.8deg) scale(0.961); }
    75%    { transform: translate(38px, 20px) rotate(-3.5deg) scale(0.971); }
    78.57% { transform: translate(27px, 14px) rotate(-2.5deg) scale(0.980); }
    82.14% { transform: translate(18px, 8px) rotate(-1.6deg) scale(0.987); }
    85.71% { transform: translate(11px, 5px) rotate(-0.9deg) scale(0.992); }
    89.29% { transform: translate(6px, 2px) rotate(-0.5deg) scale(0.996); }
    92.86% { transform: translate(2px, 1px) rotate(-0.2deg) scale(0.998); }
    96.43% { transform: translate(0px, 0px) rotate(0.0deg) scale(1.000); }
    100%   { opacity: 1; transform: none; }
  }

  /* 3 — the long one: weaves down, back up, then settles. */
  .intro__actions > *:nth-child(3) {
    --trail: var(--skills);
    --fly-name: flyWeave;
    --fly-dur: 2100ms;
    --fly-delay: 2400ms;
  }

  @keyframes flyWeave {
    0%     { opacity: 0; transform: translate(1040px, 40px) rotate(-12.0deg) scale(0.300); }
    3.57%  { opacity: 1; transform: translate(938px, -31px) rotate(-12.0deg) scale(0.356); }
    7.14%  { transform: translate(833px, -85px) rotate(-10.7deg) scale(0.410); }
    10.71% { transform: translate(728px, -125px) rotate(-7.9deg) scale(0.461); }
    14.29% { transform: translate(625px, -152px) rotate(-5.4deg) scale(0.509); }
    17.86% { transform: translate(525px, -169px) rotate(-3.3deg) scale(0.555); }
    21.43% { transform: translate(430px, -177px) rotate(-1.4deg) scale(0.598); }
    25%    { transform: translate(339px, -179px) rotate(0.3deg) scale(0.639); }
    28.57% { transform: translate(255px, -176px) rotate(1.9deg) scale(0.677); }
    32.14% { transform: translate(176px, -167px) rotate(3.4deg) scale(0.713); }
    35.71% { transform: translate(103px, -156px) rotate(4.7deg) scale(0.747); }
    39.29% { transform: translate(35px, -141px) rotate(6.1deg) scale(0.778); }
    42.86% { transform: translate(-27px, -125px) rotate(7.4deg) scale(0.807); }
    46.43% { transform: translate(-83px, -107px) rotate(8.6deg) scale(0.833); }
    50%    { transform: translate(-133px, -88px) rotate(9.9deg) scale(0.858); }
    53.57% { transform: translate(-177px, -67px) rotate(12.0deg) scale(0.880); }
    57.14% { transform: translate(-193px, -26px) rotate(12.0deg) scale(0.900); }
    60.71% { transform: translate(-172px, 6px) rotate(10.0deg) scale(0.918); }
    64.29% { transform: translate(-139px, 21px) rotate(4.7deg) scale(0.934); }
    67.86% { transform: translate(-109px, 26px) rotate(1.0deg) scale(0.949); }
    71.43% { transform: translate(-82px, 26px) rotate(-0.7deg) scale(0.961); }
    75%    { transform: translate(-59px, 23px) rotate(-1.5deg) scale(0.971); }
    78.57% { transform: translate(-41px, 18px) rotate(-1.6deg) scale(0.980); }
    82.14% { transform: translate(-26px, 13px) rotate(-1.3deg) scale(0.987); }
    85.71% { transform: translate(-15px, 9px) rotate(-0.9deg) scale(0.992); }
    89.29% { transform: translate(-8px, 5px) rotate(-0.5deg) scale(0.996); }
    92.86% { transform: translate(-3px, 2px) rotate(-0.2deg) scale(0.998); }
    96.43% { transform: translate(-1px, 0px) rotate(0.0deg) scale(1.000); }
    100%   { opacity: 1; transform: none; }
  }

  /* --- Scrim -------------------------------------------------------------- */

  .scrim {
    position: fixed;
    inset: 0;
    z-index: var(--z-scrim);
    background: rgb(2 2 8 / 0.72);
    backdrop-filter: blur(7px);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .scrim.is-open {
    opacity: 1;
  }

  @media (max-width: 46rem) {
    .hud::before {
      background: linear-gradient(
        to bottom,
        rgb(4 4 14 / 0.94) 0%,
        rgb(4 4 14 / 0.86) 38%,
        rgb(4 4 14 / 0.45) 58%,
        transparent 76%
      );
    }

    .hud {
      align-items: flex-start;
      padding-top: calc(env(safe-area-inset-top) + 4.5rem);
      padding-bottom: 9rem;
