---
import BaseLayout from '@layouts/BaseLayout.astro';
import SceneNav from '@components/SceneNav.astro';
import SettingsPanel from '@components/SettingsPanel.astro';
import Icon from '@components/Icon.astro';
import About from '@components/panels/About.astro';
import Experience from '@components/panels/Experience.astro';
import Projects from '@components/panels/Projects.astro';
import Skills from '@components/panels/Skills.astro';
import Contact from '@components/panels/Contact.astro';
import { profile, asset } from '@lib/site';

const description = `${profile.name}, ${profile.title}. ${profile.blurb}`;

// Split the name per character so each glyph can resolve on its own beat.
// Grouped by word so the heading still wraps normally on narrow viewports, and
// the running index keeps the stagger even across the space.
//
// Each glyph also gets its own approach vector, so the name assembles out of
// depth rather than sliding up as one block. A hash rather than Math.random()
// keeps the markup byte-identical between builds.
const scatter = (index: number, salt: number): number => {
  const n = Math.sin((index + 1) * 12.9898 + salt * 78.233) * 43758.5453;
  return n - Math.floor(n);
};

/** Hash output remapped to -1..1. */
const signed = (index: number, salt: number): number => scatter(index, salt) * 2 - 1;

let charIndex = 0;
const nameWords = profile.name.split(' ').map((word) => {
  const chars = [...word].map((char) => {
    const index = charIndex++;
    return {
      char,
      index,
      // Where the glyph starts, in its own 3D space. Depth does most of the
      // work; the lateral offsets project down to a few dozen pixels once
      // perspective divides them, which is the point - a hint of convergence,
      // not a scatter that reads as noise.
      style: [
        `--i: ${index}`,
        `--dx: ${(signed(index, 1) * 150).toFixed(1)}px`,
        `--dy: ${(signed(index, 2) * 130).toFixed(1)}px`,
        `--spin: ${(signed(index, 3) * 155).toFixed(1)}deg`,
        `--rx: ${scatter(index, 4).toFixed(2)}`,
        `--ry: ${scatter(index, 5).toFixed(2)}`,
        // Mostly left-to-right so it still reads as a sweep, jittered so the
        // arrivals do not land on a metronome.
        `--in-delay: ${Math.round(index * 38 + scatter(index, 6) * 70)}ms`,
      ].join('; '),
    };
  });
  charIndex += 1; // account for the space so timing stays uniform
  return chars;
});
const nameLength = charIndex;
---

<BaseLayout title="The Moundhalaverse · Emmanuel Moundhala" description={description}>
  <!-- The WebGL stage. Decorative: every section it links to is also reachable
       from the nav rail and from /resume, so nothing here is load-bearing. -->
  <div id="stage" class="stage" data-mode="loading">
    <canvas id="scene" class="stage__canvas" aria-hidden="true"></canvas>
    <div class="stage__fallback" aria-hidden="true"></div>
    <p id="hover-label" class="stage__label" aria-hidden="true" hidden></p>
  </div>

  <main id="main" class="hud">
    <header class="intro">
      <p class="intro__eyebrow">
        <span class="intro__pulse" aria-hidden="true"></span>
        {profile.title} · Messiah University ’27
      </p>

      <h1 class="intro__name" aria-label={profile.name} style={`--n: ${nameLength}`}>
        {
          nameWords.map((word, w) => (
            <>
              {w > 0 && ' '}
              <span class="intro__word" aria-hidden="true">
                {word.map(({ char, style }) => (
                  <span class="intro__char" style={style}>{char}</span>
                ))}
              </span>
            </>
          ))
        }
      </h1>

      <p class="intro__headline">
        <span id="headline" class="headline" aria-live="off">Welcome to the Moundhalaverse</span>
      </p>

      <p class="visually-hidden">
        An interactive solar system. Each planet opens a section of this portfolio. Use the
        navigation below, or the arrow keys, to explore without the 3D view.
      </p>

      <p class="intro__blurb">{profile.blurb}</p>

      <div class="intro__actions">
        <button type="button" class="btn btn--solid" data-open="projects">
          <Icon name="code" size={16} /> See my work
        </button>
        <a class="btn" href={asset('/resume')}>
          <Icon name="external" size={16} /> Résumé
        </a>
        <a class="btn" href={profile.links.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={16} /> GitHub
        </a>
      </div>
    </header>
  </main>

  <SceneNav />
  <SettingsPanel />

  <div id="scrim" class="scrim" hidden></div>

  <About />
  <Experience />
  <Projects />
  <Skills />
  <Contact />
</BaseLayout>

<script>
  import { boot } from '@scripts/app';
  import { sections, phrases, profile, asset } from '@lib/site';

  boot({
    planets: sections,
    phrases,
    portraitUrl: asset(profile.sunTexture),
  });
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: var(--z-canvas);
    background: radial-gradient(ellipse at 50% 42%, #171a3d 0%, #08081a 55%, #04040e 100%);
  }

  .stage__canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .stage[data-mode='ready'] .stage__canvas {
    opacity: 1;
  }

  /* Shown when WebGL is unavailable or the scene chunk fails to load.
     Must not take pointer events: it covers the canvas at inset 0 and paints
     after it, so without this it silently swallows every hover and click meant
     for the planets. */
  .stage__fallback {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease);
    background:
      radial-gradient(1.5px 1.5px at 20% 30%, rgb(255 255 255 / 0.7), transparent),
      radial-gradient(1.5px 1.5px at 70% 20%, rgb(255 255 255 / 0.5), transparent),
      radial-gradient(2px 2px at 40% 70%, rgb(255 255 255 / 0.6), transparent),
      radial-gradient(1px 1px at 85% 60%, rgb(255 255 255 / 0.5), transparent),
      radial-gradient(1.5px 1.5px at 10% 80%, rgb(255 255 255 / 0.4), transparent),
      radial-gradient(circle at 50% 45%, rgb(255 176 32 / 0.28), transparent 40%);
  }

  .stage[data-mode='fallback'] .stage__fallback {
    opacity: 1;
  }

  /* Floating planet label, positioned from the render loop. */
  .stage__label {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.3rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    color: var(--ink);
    background: rgb(4 4 14 / 0.78);
    border: 1px solid var(--glass-line-strong);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    will-change: transform;
  }

  /* --- HUD ---------------------------------------------------------------- */

  /* Guarantees contrast for the copy no matter where the star drifts. The
     scene is bright and moves; the text can't be left to chance. */
  .hud::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      rgb(4 4 14 / 0.92) 0%,
      rgb(4 4 14 / 0.78) 26%,
      rgb(4 4 14 / 0.35) 48%,
      transparent 68%
    );
  }

  .hud {
    position: relative;
    z-index: var(--z-chrome);
    display: flex;
    align-items: center;
    min-height: 100svh;

    /* Contains the buttons' flight paths.
       A transformed box still contributes its bounding box to the page's
       scrollable overflow, and the flights start off-screen, below the fold
       for the launch curve. That grew the scroll area mid-animation, popped a
       vertical scrollbar, and the scrollbar appearing resized the viewport,
       which read as the page shaking.
       `clip` contains it without creating a scroll container of its own, and
       nothing is lost visually because the clip edge is the viewport edge. */
    overflow: clip;
    padding:
      max(var(--sp-6), env(safe-area-inset-top))
      max(var(--sp-6), env(safe-area-inset-right))
      calc(var(--sp-8) + 3rem)
      max(var(--sp-6), env(safe-area-inset-left));
    pointer-events: none;
  }

  /* Only interactive children take pointer events; the rest of the HUD lets
     clicks fall through to the canvas so the scene stays draggable. */
  .hud :global(a),
  .hud :global(button) {
    pointer-events: auto;
  }

  .intro {
    max-width: 34rem;
    display: grid;
    gap: var(--sp-4);
  }

  .intro__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  .intro__pulse {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--experience);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--experience) 70%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    70%  { box-shadow: 0 0 0 0.6rem transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* `background-clip: text` can't be used here. The characters have to be
     inline-block to accept a transform, which makes each one an atomic inline
     whose glyphs are no longer part of the <h1>'s own text run, so the
     clipped gradient never paints into them and the name renders invisible.
     Each character samples the ramp itself instead, which survives transforms
     and gives the same left-to-right warm-to-cool sweep. */
  .intro__name {
    font-size: var(--text-3xl);
    line-height: 1.02;
    color: #fff5e2;
    /* The vanishing point the glyphs arrive through. Scoped to the heading so
       nothing else inherits a 3D context - nesting UI inside one is what made
       the old build's modals scale unpredictably. */
    perspective: 720px;
    perspective-origin: 32% 45%;
  }

  /* Perspective only reaches direct children and the glyphs sit a level deeper
     inside their word, so the word has to pass the 3D context down. */
  .intro__word {
    display: inline-block;
    transform-style: preserve-3d;
  }

  .intro__char {
    display: inline-block;
    /* Position along the name, 0 to 1. */
    --t: calc(var(--i) / var(--n));
    color: color-mix(in oklab, #fff5e2, #9fc8ff calc(var(--t) * 88%));
    opacity: 0;
    /* Only opacity and transform animate here, both compositor-friendly. */
    will-change: transform, opacity;
  }

  /* Two passes over the same glyph. They animate disjoint properties, so they
     coexist instead of the second clobbering the first. */
  body[data-stage='ready'] .intro__char {
    animation:
      charIn 2400ms linear var(--in-delay) both,
      charFlare 780ms ease-out calc(3250ms + var(--i) * 46ms) both;
  }

  /* Three acts, and depth carries all of them.

     The glyph fades in about 1600px back, where perspective renders it at
     roughly a third scale, and drifts there while it tumbles. Then it is
     pulled in, spin unwinding as it comes, overshoots a little past its line
     toward the reader, and settles.

     `linear`, with the easing carried by the keyframe spacing: an eased timing
     function is applied between *every* pair of keyframes, which at fourteen
     waypoints would stall thirteen times over. */
  @keyframes charIn {
    /* Act one: adrift, far off, still turning away. */
    0% {
      opacity: 0;
      transform: translate3d(var(--dx), var(--dy), -1600px)
        rotate3d(var(--rx), var(--ry), 1, var(--spin));
    }
    /* Visible long before it arrives, so the approach is the show. */
    8% {
      opacity: 1;
    }
    10% {
      transform: translate3d(calc(var(--dx) * 0.975), calc(var(--dy) * 0.975), -1555px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 1.06));
    }
    20% {
      transform: translate3d(calc(var(--dx) * 0.94), calc(var(--dy) * 0.94), -1495px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 1.12));
    }
    30% {
      transform: translate3d(calc(var(--dx) * 0.89), calc(var(--dy) * 0.89), -1415px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 1.18));
    }
    /* Act two: caught, and reeled in. */
    38% {
      transform: translate3d(calc(var(--dx) * 0.7), calc(var(--dy) * 0.7), -1120px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 0.95));
    }
    46% {
      transform: translate3d(calc(var(--dx) * 0.52), calc(var(--dy) * 0.52), -820px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 0.72));
    }
    54% {
      transform: translate3d(calc(var(--dx) * 0.36), calc(var(--dy) * 0.36), -545px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 0.5));
    }
    62% {
      transform: translate3d(calc(var(--dx) * 0.23), calc(var(--dy) * 0.23), -330px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 0.32));
    }
    70% {
      transform: translate3d(calc(var(--dx) * 0.13), calc(var(--dy) * 0.13), -175px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 0.18));
    }
    78% {
      transform: translate3d(calc(var(--dx) * 0.06), calc(var(--dy) * 0.06), -68px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 0.08));
    }
    /* Act three: past the line, then damped back onto it. Landing rather
       than simply stopping. */
    84% {
      transform: translate3d(calc(var(--dx) * 0.022), calc(var(--dy) * 0.022), 44px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * 0.02));
    }
    90% {
      transform: translate3d(calc(var(--dx) * 0.008), calc(var(--dy) * 0.008), 20px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * -0.02));
    }
    95% {
      transform: translate3d(calc(var(--dx) * 0.002), calc(var(--dy) * 0.002), -6px)
        rotate3d(var(--rx), var(--ry), 1, calc(var(--spin) * -0.008));
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* A wave of light crossing the finished name. `scale` is the standalone
     property rather than a transform function, so it composes with whatever
     charIn left behind instead of overwriting it.

     Starts from and returns to the glyph's own place on the warm-to-cool ramp,
     so the resting name is exactly what it was. Transparent rather than `none`
     at both ends, which gives the shadow something to interpolate against. */
  @keyframes charFlare {
    0%,
    100% {
      color: color-mix(in oklab, #fff5e2, #9fc8ff calc(var(--t) * 88%));
      text-shadow: 0 0 0 rgb(159 200 255 / 0);
      scale: 1;
    }
    36% {
      color: #ffffff;
      text-shadow:
        0 0 18px rgb(205 228 255 / 0.95),
        0 0 46px rgb(120 170 255 / 0.6),
        0 0 90px rgb(90 140 255 / 0.3);
      scale: 1.075;
    }
  }

  .intro__headline {
    min-height: 1.9em;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }

  .headline::after {
    content: '';
    display: inline-block;
    width: 0.6ch;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--contact);
    animation: caret 1.05s step-end infinite;
  }

  .headline.is-static::after {
    animation: none;
    opacity: 0.5;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .intro__blurb {
    color: var(--ink-mute);
    font-size: var(--text-base);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }

  /* Transform and opacity only - no filter. Animating blur forces a full
     repaint every frame, which is what made this choppy alongside the scene. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Entrance choreography. Timings run against the camera's intro dolly so
     the copy and the scene resolve together. */
  .intro__eyebrow,
  .intro__headline,
  .intro__blurb,
  .intro__actions > * {
    opacity: 0;
  }

  /* Nothing starts until the scene has compiled its shaders and reported
     ready. Running this against a thread that is busy building WebGL pipelines
     is what made the entrance stutter. */
  body[data-stage='ready'] :is(
    .intro__eyebrow,
    .intro__headline,
    .intro__blurb
  ) {
    animation: rise 1000ms var(--ease-out) forwards;
  }

  body[data-stage='ready'] .intro__eyebrow  { animation-delay: 120ms; }
  body[data-stage='ready'] .intro__headline { animation-delay: 2200ms; }
  body[data-stage='ready'] .intro__blurb    { animation-delay: 2500ms; }

  /* --- The three calls to action fly in ----------------------------------- */

  .intro__actions > * {
    position: relative;
    opacity: 0;
    will-change: transform, opacity;
  }

  /*
     The buttons rest on the left of the hero, so they fly in from the right
     across the full width. A left-to-right approach would spend most of its
     travel off-screen.

     These are transform keyframes rather than `offset-path`. Motion path
     positions the element's anchor relative to its containing block, not its
     natural spot, so the buttons settled tens of pixels off their layout
     position, and the first one ended up off the left edge entirely. Waypoints
     land at `transform: none`, which is the resting position by definition.
     Rotation is authored per keyframe to bank each button into its curve.
  */

  /* The exhaust trail, hanging off the trailing (right) edge. It inherits the
     parent's bank, so it stays pointed back down the flight path. */
  .intro__actions > *::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: 320px;
    height: 5px;
    margin: -2.5px 0 0 -10px;
    border-radius: var(--radius-full);
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(
      to right,
      var(--trail),
      color-mix(in srgb, var(--trail) 55%, transparent) 30%,
      color-mix(in srgb, var(--trail) 15%, transparent) 62%,
      transparent 94%
    );
    opacity: 0;
    pointer-events: none;
  }

  /* Impact ring, timed to the moment it settles. */
  .intro__actions > *::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: var(--radius-full);
    border: 2px solid var(--trail);
    opacity: 0;
    pointer-events: none;
  }

  body[data-stage='ready'] .intro__actions > * {
    /* linear on purpose; the keyframe spacing carries the easing. An eased
       timing function is applied between *every* keyframe pair, so with
       waypoints this dense it would slow and re-accelerate 16 times over. */
    animation: var(--fly-name) var(--fly-dur) linear var(--fly-delay) forwards;
  }

  body[data-stage='ready'] .intro__actions > *::before {
    animation: trail var(--fly-dur) var(--ease-out) var(--fly-delay) forwards;
  }

  body[data-stage='ready'] .intro__actions > *::after {
    animation: impact var(--fly-dur) linear var(--fly-delay) forwards;
  }

  @keyframes trail {
    0%    { opacity: 0;   transform: scaleX(0.05); }
    9%    { opacity: 1;   transform: scaleX(1); }
    32%   { opacity: 0.8; transform: scaleX(0.76); }
    54%   { opacity: 0.2; transform: scaleX(0.26); }
    100%  { opacity: 0;   transform: scaleX(0); }
  }

  @keyframes impact {
    0%, 91% { opacity: 0;   scale: 0.85; }
    96%     { opacity: 0.9; scale: 1; }
    100%    { opacity: 0;   scale: 1.5; }
  }

  /* 1. Enters high on the right and sweeps down across the hero. */
  .intro__actions > *:nth-child(1) {
    --trail: var(--sun);
    --fly-name: flySweep;
    --fly-dur: 2900ms;
    --fly-delay: 1800ms;
  }

  @keyframes flySweep {
    0%     { opacity: 0; transform: translate(980px, -330px) rotate(-8.8deg) scale(0.300); }
    3.12%  { opacity: 1; transform: translate(886px, -354px) rotate(-4.4deg) scale(0.360); }
    6.25%  { transform: translate(796px, -364px) rotate(-1.4deg) scale(0.416); }
    9.38%  { transform: translate(710px, -365px) rotate(0.9deg) scale(0.469); }
    12.5%  { transform: translate(629px, -359px) rotate(2.7deg) scale(0.518); }
    15.62% { transform: translate(554px, -349px) rotate(4.1deg) scale(0.565); }
    18.75% { transform: translate(484px, -336px) rotate(5.4deg) scale(0.609); }
    21.88% { transform: translate(420px, -321px) rotate(6.5deg) scale(0.649); }
    25%    { transform: translate(360px, -304px) rotate(7.5deg) scale(0.687); }
    28.12% { transform: translate(306px, -287px) rotate(8.5deg) scale(0.722); }
    31.25% { transform: translate(256px, -269px) rotate(9.5deg) scale(0.755); }
    34.38% { transform: translate(211px, -251px) rotate(10.5deg) scale(0.785); }
    37.5%  { transform: translate(171px, -232px) rotate(11.5deg) scale(0.812); }
    40.62% { transform: translate(134px, -214px) rotate(12.0deg) scale(0.837); }
    43.75% { transform: translate(102px, -195px) rotate(12.0deg) scale(0.860); }
    46.88% { transform: translate(73px, -177px) rotate(12.0deg) scale(0.881); }
    50%    { transform: translate(57px, -152px) rotate(12.0deg) scale(0.899); }
    53.12% { transform: translate(44px, -129px) rotate(10.3deg) scale(0.916); }
    56.25% { transform: translate(34px, -107px) rotate(8.5deg) scale(0.931); }
    59.38% { transform: translate(26px, -88px) rotate(6.9deg) scale(0.944); }
    62.5%  { transform: translate(19px, -70px) rotate(5.5deg) scale(0.955); }
    65.62% { transform: translate(14px, -55px) rotate(4.3deg) scale(0.965); }
    68.75% { transform: translate(10px, -43px) rotate(3.3deg) scale(0.973); }
    71.88% { transform: translate(7px, -32px) rotate(2.5deg) scale(0.980); }
    75%    { transform: translate(5px, -23px) rotate(1.8deg) scale(0.986); }
    78.12% { transform: translate(3px, -16px) rotate(1.2deg) scale(0.990); }
    81.25% { transform: translate(2px, -10px) rotate(0.8deg) scale(0.994); }
    84.38% { transform: translate(1px, -6px) rotate(0.5deg) scale(0.996); }
    87.5%  { transform: translate(1px, -3px) rotate(0.3deg) scale(0.998); }
    90.62% { transform: translate(0px, -1px) rotate(0.1deg) scale(0.999); }
    93.75% { transform: translate(0px, 0px) rotate(0.0deg) scale(1.000); }
    96.88% { transform: translate(0px, 0px) rotate(0.0deg) scale(1.000); }
    100%   { opacity: 1; transform: none; }
  }

  /* 2. A shooting star climbing in from the lower right. */
  .intro__actions > *:nth-child(2) {
    --trail: #bfe4ff;
    --fly-name: flyStar;
    --fly-dur: 2900ms;
    --fly-delay: 2300ms;
