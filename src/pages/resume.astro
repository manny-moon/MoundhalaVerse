---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import { profile, education, about, asset, formatRange } from '@lib/site';

/**
 * The plain route.
 *
 * Real text, crawlable, linkable, and printable. The solar system is a fun way
 * in — it should never be the only way in.
 */

const experienceEntries = await getCollection('experience');
const experience = experienceEntries.sort((a, b) => b.data.start.localeCompare(a.data.start));

const projectEntries = await getCollection('projects');
const projects = projectEntries.sort((a, b) => b.data.year - a.data.year);

const skillGroups = await getCollection('skills');
const ORDER = ['languages', 'tools', 'coursework', 'spoken'];
const skills = skillGroups.sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));

const description = `Résumé of ${profile.name} — ${profile.title} at ${education.school}, graduating ${formatRange(education.start, education.end).split('—')[1]?.trim()}.`;
---

<BaseLayout title={`Résumé · ${profile.name}`} description={description} plain>
  <div class="page">
    <a class="back" href={asset('/')}>
      <Icon name="arrow-right" size={15} class="back__icon" /> Back to the Moundhalaverse
    </a>

    <main id="main" class="doc">
      <header class="doc__head">
        <div>
          <h1>{profile.name}</h1>
          <p class="doc__title">{profile.title}</p>
        </div>

        <ul class="doc__contact">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={`tel:${profile.phone.replace(/\D/g, '')}`}>{profile.phone}</a></li>
          <li><a href={profile.links.linkedin} rel="noopener">linkedin.com/in/emmanuel-moundhala</a></li>
          <li><a href={profile.links.github} rel="noopener">github.com/Arcullius</a></li>
          <li>{profile.location}</li>
        </ul>
      </header>

      <section class="doc__section">
        <h2>Summary</h2>
        {about.bio.map((paragraph) => <p class="prose">{paragraph}</p>)}
      </section>

      <section class="doc__section">
        <h2>Education</h2>
        <div class="item">
          <div class="item__head">
            <h3>{education.school}</h3>
            <span class="item__when">{formatRange(education.start, education.end)}</span>
          </div>
          <p class="item__sub">{education.degree} · {education.location}</p>
        </div>
      </section>

      <section class="doc__section">
        <h2>Experience</h2>
        {
          experience.map((entry) => (
            <article class="item">
              <div class="item__head">
                <h3>{entry.data.company}</h3>
                <span class="item__when">{formatRange(entry.data.start, entry.data.end)}</span>
              </div>
              <p class="item__sub">{entry.data.role} · {entry.data.location}</p>
              <ul class="bullets">
                {entry.data.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="doc__section">
        <h2>Projects</h2>
        {
          projects.map((project) => (
            <article class="item">
              <div class="item__head">
                <h3>
                  {project.data.title}
                  <span class="item__stack"> · {project.data.tags.join(', ')}</span>
                </h3>
                <span class="item__when">{project.data.year}</span>
              </div>
              <p class="prose">{project.data.description}</p>
              {project.data.links.length > 0 && (
                <p class="item__links">
                  {project.data.links.map((link) => (
                    <a href={link.href} rel="noopener">{link.label}</a>
                  ))}
                </p>
              )}
            </article>
          ))
        }
      </section>

      <section class="doc__section">
        <h2>Technical Skills</h2>
        <dl class="skills">
          {
            skills.map((group) => (
              <div class="skills__row">
                <dt>{group.data.title}</dt>
                <dd>
                  {group.data.items
                    .map((item) => (item.note ? `${item.name} (${item.note})` : item.name))
                    .join(', ')}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <footer class="doc__foot">
        <a class="btn btn--solid" href={asset(profile.resume)} download>
          <Icon name="download" size={15} /> Download the PDF
        </a>
        <p class="doc__note">
          This page and the PDF are generated from the same content files, so they can't
          disagree with each other.
        </p>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    --accent: var(--experience);
    min-height: 100svh;
    padding: var(--sp-6) var(--sp-4) var(--sp-8);
    background:
      radial-gradient(60rem 40rem at 50% -10%, rgb(78 205 196 / 0.07), transparent),
      var(--void);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    max-width: 52rem;
    margin: 0 auto var(--sp-5);
    font-size: var(--text-sm);
    color: var(--ink-mute);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .back:hover { color: var(--ink); }

  .back :global(.back__icon) { rotate: 180deg; }

  .doc {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--sp-7);
    background: rgb(255 255 255 / 0.025);
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-lg);
  }

  .doc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--glass-line);
  }

  .doc__head h1 {
    font-size: var(--text-2xl);
  }

  .doc__title {
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .doc__contact {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-xs);
    color: var(--ink-mute);
    text-align: right;
  }

  .doc__contact a {
    color: inherit;
    text-decoration: none;
  }

  .doc__contact a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .doc__section {
    margin-top: var(--sp-6);
  }

  .doc__section h2 {
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-2);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    border-bottom: 1px solid var(--glass-line);
  }

  .item + .item {
    margin-top: var(--sp-5);
  }

  .item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .item__head h3 {
    font-size: var(--text-base);
  }

  .item__stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-faint);
  }

  .item__when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .item__sub {
    margin-top: 0.1rem;
    font-size: var(--text-sm);
    color: var(--ink-mute);
  }

  .item__links {
    margin-top: var(--sp-2);
    display: flex;
    gap: var(--sp-3);
    font-size: var(--text-sm);
  }

  .bullets {
    margin-top: var(--sp-3);
    display: grid;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .bullets li {
    position: relative;
    padding-left: 1.15rem;
  }

  .bullets li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .prose {
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .skills__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--sp-4);
    padding: var(--sp-2) 0;
    font-size: var(--text-sm);
  }

  .skills__row + .skills__row {
    border-top: 1px solid color-mix(in srgb, var(--glass-line) 60%, transparent);
  }

  .skills dt {
    font-weight: 600;
    color: var(--ink);
  }

  .skills dd {
    margin: 0;
    color: var(--ink-mute);
  }

  .doc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--glass-line);
  }

  .doc__note {
    flex: 1 1 18rem;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .doc {
      padding: var(--sp-5) var(--sp-4);
    }

    .doc__contact {
      text-align: left;
    }

    .skills__row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }

  /* Print: drop the chrome, go to ink on paper. */
  @media print {
    .page {
      padding: 0;
      background: #fff;
    }

    .back,
    .doc__foot {
      display: none;
    }

    .doc {
      max-width: none;
      padding: 0;
      border: none;
      background: none;
      color: #000;
    }

    .doc :global(h1),
    .doc :global(h2),
    .doc :global(h3),
    .doc :global(dt) {
      color: #000;
    }

    .doc :global(p),
    .doc :global(li),
    .doc :global(dd),
    .doc :global(a) {
      color: #222;
    }

    .doc__section {
      break-inside: avoid;
    }

    .item {
      break-inside: avoid;
    }
  }
</style>
