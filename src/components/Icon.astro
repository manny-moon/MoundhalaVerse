---
/**
 * Inline SVG icons.
 *
 * Replaces the Font Awesome CDN stylesheet the previous build loaded on every
 * page. That was a render-blocking request to a third party for what amounts
 * to about twenty glyphs. These ship in the HTML and cost nothing extra.
 *
 * Stroke-based, 24x24 viewBox, inheriting `currentColor`.
 */
export type IconName =
  | 'user'
  | 'briefcase'
  | 'code'
  | 'wrench'
  | 'mail'
  | 'github'
  | 'linkedin'
  | 'download'
  | 'eye'
  | 'external'
  | 'settings'
  | 'close'
  | 'building'
  | 'google'
  | 'database'
  | 'cloud'
  | 'flame'
  | 'git'
  | 'window'
  | 'book'
  | 'globe'
  | 'phone'
  | 'pin'
  | 'graduation'
  | 'sparkle'
  | 'target'
  | 'heart'
  | 'arrow-right'
  | 'keyboard'
  | 'gauge'
  | 'java'
  | 'python'
  | 'javascript'
  | 'typescript'
  | 'html';

interface Props {
  name: IconName | string;
  size?: number | string;
  class?: string;
  /** Icons are decorative by default; pass a label to expose one to AT. */
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

